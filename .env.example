# Database — Neon (serverless PostgreSQL) connection string.
# Local dev points at a dev Neon branch. Use the *direct* (unpooled) endpoint here:
# `prisma migrate` needs session features the pooler doesn't support, and local
# dev doesn't need pooling. The *pooled* endpoint (host contains "-pooler") is for
# serverless runtimes and is set as a Netlify env var for production, not here.
# Netlify also sets DATABASE_URL_UNPOOLED (direct) for the build-time
# `prisma migrate deploy`; local dev needs only this one key.
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Storage — Cloudflare R2 (S3-compatible). Local dev uses a dev bucket;
# production is set as a Netlify env var.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-dev-bucket-name"

# Auth — self-hosted Logto (OSS). Local dev and the dev deploy point at the dev
# instance; production at the pro instance (set as Netlify env vars). LOGTO_BASE_URL
# is this app's own base URL (used to build the sign-in callback
# {LOGTO_BASE_URL}/callback) — set it WITHOUT a trailing slash.
# LOGTO_COOKIE_SECRET must be a long random string (e.g. `openssl rand -base64 32`).
LOGTO_ENDPOINT="https://auth-dev.kasumin.biz"
LOGTO_APP_ID="your-logto-app-id"
LOGTO_APP_SECRET="your-logto-app-secret"
LOGTO_BASE_URL="http://localhost:3000"
LOGTO_COOKIE_SECRET="replace-with-a-long-random-string"

# Notifications — LINE Messaging API. Channel access token for the official
# account, used to push notifications to a user's lineUserId. Optional: when this
# is unset (or a user has no lineUserId yet), LINE pushes are a silent no-op and
# only in-app notifications are delivered. Capturing lineUserId via the
# registration friend-add is a separate follow-up.
LINE_CHANNEL_ACCESS_TOKEN=""

# E2E (Playwright) — base URL of the app under test.
E2E_BASE_URL=http://localhost:3000

# Screenshot tooling (scripts/screenshot.mjs, run via `pnpm screenshot`) — all
# optional. The email/password are a dev-environment test account used to sign
# in through Logto before capturing authenticated pages; leave them unset for
# public pages. CHROMIUM_PATH overrides playwright's browser auto-detection.
SCREENSHOT_EMAIL="dev-test-account@example.com"
SCREENSHOT_PASSWORD="dev-test-account-password"
# CHROMIUM_PATH="/path/to/chromium"

# Image hosting for the screenshots above (imgBB) — optional, and used only to
# get a URL that can be embedded in a PR description. Screenshots are never
# committed (the *-mobile.png / *-desktop.png patterns are git-ignored), so they
# have to be hosted somewhere to be visible in a PR. Get a key from
# https://api.imgbb.com/ ("Get API key", signed in). Nothing in the app reads
# this; it is developer tooling only.
IMGBB_API_KEY="your-imgbb-api-key"
